# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://user:password@localhost:5432/vehicle_compliance

# AWS: S3 for image storage, Rekognition for text detection
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=1h

# SMTP for compliance emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=

# Public address of the app, used in email links
BASE_URL=http://localhost:3000
